generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum JobType {
  roadmap
  assessment
  diagnostic
  modification
}

enum JobStatus {
  pending
  ready
  failed
}

enum RoadmapStatus {
  active
  archived
}

enum MilestoneStatus {
  locked
  active
  completed
}

enum ChapterStatus {
  not_started
  in_progress
  knowledge_check_pending
  completed
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  profile          UserProfile?
  roadmaps         Roadmap[]
  attempts         Attempt[]
  chapterNotes     ChapterNote[]
  learnerRating    LearnerRating?
  conceptMastery   ConceptMastery[]
  interactionLogs  InteractionLog[]

  @@map("users")
}

model UserProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  goal                   String
  interestTags           String[] @map("interest_tags")
  preparednessLevel      String   @map("preparedness_level")
  selfRatedKnowledge     String   @default("beginner") @map("self_rated_knowledge")
  diagnosticScore        Float?   @map("diagnostic_score")
  diagnosticWeakConcepts String[] @map("diagnostic_weak_concepts")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Roadmap {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  status    RoadmapStatus @default(active)
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  changeLogs RoadmapChangeLog[]

  @@map("roadmaps")
}

model Milestone {
  id          String          @id @default(cuid())
  roadmapId   String          @map("roadmap_id")
  order       Int
  title       String
  description String?
  status      MilestoneStatus @default(locked)
  createdAt   DateTime        @default(now()) @map("created_at")

  roadmap  Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@map("milestones")
}

model Chapter {
  id          String        @id @default(cuid())
  milestoneId String        @map("milestone_id")
  order       Int
  title       String
  objectives  String[]
  status      ChapterStatus @default(not_started)
  createdAt   DateTime      @default(now()) @map("created_at")

  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  notes       ChapterNote[]
  assessments Assessment[]

  @@map("chapters")
}

model ChapterNote {
  id          String   @id @default(cuid())
  chapterId   String   @map("chapter_id")
  userId      String   @map("user_id")
  fileUrl     String?  @map("file_url")
  fileType    String?  @map("file_type")
  contentText String?  @map("content_text")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chapter_notes")
}

model Assessment {
  id          String   @id @default(cuid())
  chapterId   String   @map("chapter_id")
  difficulty  Int      @default(2)
  generatedAt DateTime @default(now()) @map("generated_at")

  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]

  @@map("assessments")
}

model Question {
  id           String @id @default(cuid())
  assessmentId String @map("assessment_id")
  text         String
  options      String[]
  correctIndex Int    @map("correct_index")
  conceptTag   String @map("concept_tag")
  explanation  String
  /// Elo rating seeded from difficulty at generation time (easy≈1000, medium≈1200, hard≈1400).
  /// Updated after every attempt via the TRACE-KT engine.
  eloRating    Float  @default(1200) @map("elo_rating")

  /// ──── TRACE-KT: Question Trust Score ────
  /// Composite trust score ∈ [0, 1] computed at generation time from concept consistency,
  /// relevance, difficulty calibration, and format quality.
  /// Low-trust questions have reduced influence on mastery estimation.
  trustScore   Float  @default(0.5) @map("trust_score")

  /// Number of total responses received — used for difficulty calibration component of trust.
  responseCount Int   @default(0) @map("response_count")
  /// Empirical correctness rate — updated after each response for trust recalibration.
  empiricalCorrectRate Float? @map("empirical_correct_rate")

  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  interactionLogs InteractionLog[]
  trustLogs       QuestionTrustLog[]

  @@map("questions")
}

model Attempt {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  assessmentId String   @map("assessment_id")
  score        Float
  answers      Json
  passed       Boolean
  attemptedAt  DateTime @default(now()) @map("attempted_at")

  /// ──── TRACE-KT: Behavioral Data ────
  /// Per-question response times in milliseconds, stored as JSON array matching question order.
  responseTimesMs Json?  @map("response_times_ms")
  /// Per-question hint counts (how many distractors were eliminated), JSON array.
  hintCounts      Json?  @map("hint_counts")
  /// Per-question confidence levels (5-point Likert mapped to [0, 0.25, 0.5, 0.75, 1.0]), JSON array.
  confidences     Json?  @map("confidences")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("attempts")
}

model RoadmapChangeLog {
  id          String    @id @default(cuid())
  roadmapId   String    @map("roadmap_id")
  versionFrom Int       @map("version_from")
  versionTo   Int       @map("version_to")
  diffJson    Json      @map("diff_json")
  userPrompt  String    @map("user_prompt")
  // pending | confirmed | rejected
  status      String    @default("pending")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@map("roadmap_change_logs")
}

/// Backs every async NIM generation call.
/// resultRef stores the ID of the entity being generated (roadmapId, assessmentId, etc.)
model GenerationJob {
  id        String    @id @default(cuid())
  type      JobType
  status    JobStatus @default(pending)
  resultRef String?   @map("result_ref")
  error     String?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([resultRef])
  @@index([type, status])
  @@map("generation_jobs")
}

// ─── TRACE-KT: Adaptive Mastery Engine ────────────────────────────────────────

/// Live Elo rating per learner. Upserted on first attempt (default 1200).
/// Updated by the TRACE-KT engine after every graded attempt.
model LearnerRating {
  userId    String   @id @map("user_id")
  rating    Float    @default(1200)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_ratings")
}

/// TRACE-KT posterior per (learner, concept). One row per concept tag per user.
/// Tracks both mastery probability and epistemic uncertainty via Beta distribution.
model ConceptMastery {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  conceptTag String   @map("concept_tag")

  /// BKT mastery posterior ∈ [0, 1]. Starts at 0.3 (conservative prior).
  pMastery   Float    @default(0.3) @map("p_mastery")

  /// ──── TRACE-KT: Uncertainty Tracking ────
  /// Epistemic uncertainty ∈ [0, 1] derived from Beta(α, β) distribution.
  /// High = few/inconsistent interactions; Low = many consistent interactions.
  uncertainty Float   @default(0.5)
  /// Beta distribution shape parameter α (evidence for mastery).
  betaAlpha   Float   @default(1.0) @map("beta_alpha")
  /// Beta distribution shape parameter β (evidence against mastery).
  betaBeta    Float   @default(1.0) @map("beta_beta")

  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptTag])
  @@index([userId])
  @@map("concept_mastery")
}

// ─── TRACE-KT: Interaction & Trust Logging ────────────────────────────────────

/// Per-question behavioral interaction log for TRACE-KT.
/// Records the full cognitive evidence for each learner-question interaction.
model InteractionLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  questionId     String   @map("question_id")
  conceptTag     String   @map("concept_tag")

  correct        Boolean
  responseTimeMs Int      @map("response_time_ms")
  hintCount      Int      @default(0) @map("hint_count")
  /// Confidence level from 5-point Likert: 0.0, 0.25, 0.5, 0.75, 1.0
  confidence     Float    @default(0.5)
  /// Which attempt number this is for this concept (for attempt decay factor)
  attemptNumber  Int      @default(1) @map("attempt_number")

  /// Computed CES (Cognitive Evidence Strength) for this interaction
  cesScore       Float?   @map("ces_score")
  /// Effective evidence weight = CES × trust
  effectiveWeight Float?  @map("effective_weight")

  createdAt      DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, conceptTag])
  @@index([questionId])
  @@map("interaction_logs")
}

/// Audit trail for question trust score computation.
/// One row per trust computation (at generation time + recalibrations).
model QuestionTrustLog {
  id                   String   @id @default(cuid())
  questionId           String   @map("question_id")

  /// Component scores
  conceptConsistency   Float    @map("concept_consistency")
  relevanceScore       Float    @map("relevance_score")
  difficultyCalibration Float   @map("difficulty_calibration")
  formatScore          Float    @map("format_score")

  /// Weighted composite
  overallTrust         Float    @map("overall_trust")

  /// Whether this is the initial computation or a recalibration
  isRecalibration      Boolean  @default(false) @map("is_recalibration")

  createdAt            DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_trust_logs")
}
